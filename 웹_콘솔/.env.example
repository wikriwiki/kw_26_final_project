# ============================================================================
# 웹 콘솔 / 보고서 v2 환경 변수 예시
#
#   cp .env.example .env      (윈도우: Copy-Item .env.example .env)
#
# `.env` 는 커밋하지 않는다 (.gitignore 에 이미 들어 있다).
# 값이 비어 있으면 그 기능은 **꺼진 채로 그렇게 표시된다.** 조용히 대체되지 않는다.
# ============================================================================

# ---------------------------------------------------------------------------
# 1. 보고서 해설 LLM
# ---------------------------------------------------------------------------
# 아래 GEMINI_API_KEY 한 줄만 채우면 보고서 해설이 켜진다.
# 키 발급: https://aistudio.google.com/apikey
#
# 해설 LLM 은 **숫자를 만들지 않는다.** 계산 결과 JSON 만 보고 문장을 쓰며,
# 생성된 문장의 숫자는 계산 결과의 숫자 집합과 대조된다(scripts/report/llm.py의
# numeric_guard). 근거 없는 숫자가 하나라도 있으면 그 문단은 채택되지 않고
# 규칙 기반 문장으로 되돌아간다. 그 사실은 보고서 마지막 절에 기록된다.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# 프록시나 리전 엔드포인트를 쓸 때만 바꾼다
# GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta

# 제공자 선택: auto | gemini | openai | none
#   auto   GEMINI_API_KEY 가 있으면 gemini, 없고 REPORT_LLM_BASE_URL 이 있으면 openai
#   none   해설을 아예 호출하지 않는다 (보고서는 그대로 생성된다)
REPORT_LLM_PROVIDER=auto

# 사내 vLLM / SGLang 등 OpenAI 호환 서버를 쓸 때
# REPORT_LLM_BASE_URL=http://127.0.0.1:30000/v1
# REPORT_LLM_MODEL=exaone-4.5
# REPORT_LLM_API_KEY=

REPORT_LLM_TIMEOUT=60
REPORT_LLM_MAX_TOKENS=900
REPORT_LLM_TEMPERATURE=0.2

# ---------------------------------------------------------------------------
# 2. 콘솔 API 가 읽는 run 산출물
# ---------------------------------------------------------------------------
# 완료된 run 들이 들어 있는 루트. out_BASE / out_FINAL / rescue/out_BASE7500
SIM_DATA_ROOT=C:\Users\srdyh\gpu_exp_data\demo

# 개발용 픽스처 모드 (실제 산출물 없이 화면만 볼 때). 실제 보고서는 만들 수 없다.
# SIM_USE_FIXTURES=1

# 프런트 개발 서버 주소 — CORS 허용 목록
WEB_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# 3. 시뮬레이션 실행 명령 (콘솔의 "실행 시작" 버튼)
# ---------------------------------------------------------------------------
# 콘솔은 임의 shell 명령을 받지 않는다. 운영자가 여기 적은 **고정 명령만** 실행한다.
# 실행 파라미터(run id·시작일·기간·대상자 수)는 아래 환경변수로 자식 프로세스에 전달된다:
#   SIM_RUN_ID / SIM_POLICY_ID / SIM_START_DAY / SIM_DAYS / SIM_AGENTS
# 값이 없으면 실행 버튼은 503 과 함께 "구성되지 않았다"고 답한다.
# SIM_RUN_COMMAND_JSON=["python","scripts/sim/run_simulation.py"]

# 실행 lock 파일 위치 (기본: web/.run.lock)
# SIM_LOCK_PATH=

# ---------------------------------------------------------------------------
# 4. Neo4j — 기존 DASOL 엔진에서만 필요하다
# ---------------------------------------------------------------------------
# 보고서 v2 는 파일만 읽으므로 아래 값 없이도 동작한다.
# NEO4J_URI=bolt://127.0.0.1:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=
# NEO4J_DATABASE=neo4j
# DASOL_NEO4J_RUN_ID=
