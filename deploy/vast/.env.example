# Copy to deploy/vast/local.env on the rented Linux host and source it.
# Keep the Vast API key on the operator's computer, never on this host.
# LG official EXAONE 4.5 AWQ uses compressed-tensors metadata (W4A16).
MODEL=LGAI-EXAONE/EXAONE-4.5-33B-AWQ
LLM_MODE=exaone_4_5
MODEL_REVISION=31e6a965d0661bbe4a8b895e22a77f8271772ba0
PORT=8000
MAX_MODEL_LEN=8192
MAX_NUM_SEQS=4
GPU_MEMORY_UTILIZATION=0.88
TENSOR_PARALLEL_SIZE=1
ATTENTION_BACKEND=triton
SGLANG_VENV=/workspace/venv_sgl
# Leave unset: use the model's compressed-tensors configuration automatically.
# Do not force the unrelated awq_marlin quantization format.
QUANTIZATION=
HF_HOME=/workspace/huggingface
RUN_ID=no-smoking-pilot
RUN_TIMEOUT_SECONDS=3600
# Production: 14 days before + 14 days from the 2017-12-03 policy start.
# The readiness pilot explicitly overrides DAYS=1; Day 0 must be 2017-11-18.
START_DATE=2017-11-19
DAYS=28
WORKERS=4
# Fill isolated arm endpoints after restoring the same verified Day 0 snapshot.
NO_SMOKING_OFF_NEO4J_URI=
NO_SMOKING_ON_NEO4J_URI=
NO_SMOKING_OFF_NEO4J_DATABASE=neo4j
NO_SMOKING_ON_NEO4J_DATABASE=neo4j
NO_SMOKING_SNAPSHOT_SHA256=
NEO4J_USER=neo4j
NEO4J_PASSWORD=
# Verified rebuilt clean Day 0 dump only; never point at the post-run source dump.
CLEAN_BASELINE_DUMP=
NO_SMOKING_NEO4J_ROOT=/workspace/no-smoking-neo4j
NO_SMOKING_OFF_BOLT_PORT=17687
NO_SMOKING_ON_BOLT_PORT=17688
NO_SMOKING_NEO4J_HEAP_MB=2048
NO_SMOKING_NEO4J_PAGECACHE_MB=512
NO_SMOKING_NEO4J_MIN_FREE_GB=20
NO_SMOKING_NEO4J_STARTUP_SECONDS=180
NO_SMOKING_NEO4J_LOAD_SECONDS=900
