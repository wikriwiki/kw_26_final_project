# generate_agents.py 환경변수 템플릿
# 사용: `cp .env.example .env` 후 값 채우기. 셸에서 `set -a; source .env; set +a` 로 export.

# 모델 모드: qwen32b | qwen9b | exaone   (CLI `--model` 이 더 우선)
LLM_MODE=qwen32b

# SGLang 서버 OpenAI 호환 엔드포인트 (포트는 serve_*.sh 의 PORT 와 일치해야 함)
SGLANG_BASE_URL=http://localhost:30000/v1

# 동시 LLM 요청 수 (CLI `--max-concurrent` 가 더 우선)
MAX_CONCURRENT=8
